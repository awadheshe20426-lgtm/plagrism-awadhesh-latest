# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/plagiarism_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_TYPE=s3  # or 'local'
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=plagiarism-uploads

# AI Detection
USE_EXTERNAL_AI_DETECTION=false
OPENAI_API_KEY=
TOGETHER_API_KEY=

# CU AI gateway (Gemma 4 via OpenAI-compatible API) — used by POST /api/v1/upload
LLM_GATEWAY_BASE_URL=https://llm.unicornfortunes.com/v1
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=gemma4-26b
LLM_GATEWAY_ALLOWED_MODELS=qwen2.5-14b,gemma4-26b,nemotron-vl,qwen3-30b-a3b
LLM_GATEWAY_VISION_MODELS=gemma4-26b,nemotron-vl
LLM_GATEWAY_MAX_TOKENS=1024

# Web-source check (finds the website a submission was copied from).
# WEB_SEARCH_PROVIDER: comma-separated, all are queried and merged (empty = disabled).
#   free, no key: searxng (self-hosted), wikipedia, openalex (research papers)
#   need a key:   google_cse, brave, serpapi
WEB_SEARCH_PROVIDER=searxng,wikipedia,openalex
SEARXNG_URL=http://searxng:8080
WEB_WIKIPEDIA_LANG=en
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_API_KEY=
SERPAPI_KEY=
WEB_SEARCH_MAX_QUERIES=25
WEB_SEARCH_WORDS_PER_QUERY=40
WEB_SEARCH_MAX_PAGES=25
WEB_MIN_MATCH_WORDS=12
WEB_PARAPHRASE_ENABLED=true
WEB_PARAPHRASE_MIN_SIMILARITY=0.80
WEB_PARAPHRASE_MIN_OVERLAP=0.45
WEB_FETCH_TIMEOUT=10
WEB_CACHE_TTL_DAYS=7
WEB_EXCLUDE_DOMAINS=

# Celery & Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Environment
ENVIRONMENT=production