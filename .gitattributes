# Normalise text files to LF in the repository.
* text=auto

# Scripts and container files must keep LF so they run on Linux servers.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Binary files: never convert line endings.
*.pdf binary
*.docx binary
*.doc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
